enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  VENDOR
  TEACHER
}

enum VendorStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole

  // School relation (only for school users)
  schoolId Int?
  school   School? @relation(fields: [schoolId], references: [id])

  // Vendor-specific fields
  vendorName   String?
  phoneNumber  String?
  location     String?
  vendorStatus VendorStatus?

  mustChangePassword Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}

