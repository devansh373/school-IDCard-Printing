generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model School {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique

  classes  Class[]
  students Student[]

  users     User[]
  createdAt DateTime @default(now())
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  sections Section[]
  students Student[]
}

model Section {
  id      Int    @id @default(autoincrement())
  name    String
  classId Int
  class   Class  @relation(fields: [classId], references: [id])

  students Student[]
}

enum PhotoStatus {
  NOT_UPLOADED
  UPLOADED
}

enum PrintStatus {
  PENDING
  READY
  PRINTED
  DELIVERED
}

model Student {
  id               Int    @id @default(autoincrement())
  enrollmentNumber String @unique
  name             String

  schoolId  Int
  classId   Int
  sectionId Int

  school  School  @relation(fields: [schoolId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  photoUrl    String?
  photoStatus PhotoStatus @default(NOT_UPLOADED)

  printStatus PrintStatus @default(PENDING)
}

